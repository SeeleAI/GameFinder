# Nexus API metadata and research. Never commit a real key.
NEXUS_API_KEY=

# Optional dedicated persistent Chromium profile override.
# Keep this outside the repository and outside your everyday Chrome/Edge profile.
# NEXUS_BROWSER_PROFILE_DIR=C:\Users\<you>\AppData\Local\GameFinder\nexus-browser-profile

# Optional browser timeouts in milliseconds.
NEXUS_BROWSER_LAUNCH_TIMEOUT_MS=30000
NEXUS_BROWSER_NAVIGATION_TIMEOUT_MS=45000
NEXUS_BROWSER_DOWNLOAD_START_TIMEOUT_MS=120000
# Zero disables a fixed total transfer timeout.
NEXUS_BROWSER_DOWNLOAD_TIMEOUT_MS=0
NEXUS_BROWSER_LOGIN_WAIT_MS=900000

# Keep the dedicated browser available while the MCP process remains alive.
NEXUS_BROWSER_KEEP_OPEN=true
