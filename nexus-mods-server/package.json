{
  "name": "nexus-mods-server",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP server for Nexus Mods research, verified downloads, transactional Mod management, and Windows game saves.",
  "type": "module",
  "bin": {
    "nexus-mods-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-save-recipes.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live.test.ts",
    "test:browser": "vitest run tests/browser-persistence.integration.test.ts tests/browser-download-flow.integration.test.ts",
    "test:stdio": "tsx scripts/smoke-stdio.ts",
    "acceptance:download": "tsx scripts/acceptance-download.ts",
    "acceptance:browser-login": "tsx scripts/acceptance-browser-login.ts",
    "acceptance:browser-login-persistence": "tsx scripts/acceptance-browser-login-persistence.ts",
    "acceptance:browser-download": "tsx scripts/acceptance-browser-download.ts",
    "acceptance:browser-expired-login": "tsx scripts/acceptance-browser-expired-login.ts",
    "acceptance:browser-interactions": "tsx scripts/acceptance-browser-interactions.ts",
    "acceptance:browser-profile-busy": "tsx scripts/acceptance-browser-profile-busy.ts",
    "acceptance:browser-cdp-probe": "tsx scripts/acceptance-browser-cdp-probe.ts",
    "acceptance:browser-cdp-clearance": "tsx scripts/acceptance-browser-cdp-clearance.ts",
    "acceptance:browser-cdp-download": "pnpm build && node dist/acceptance-browser-cdp-download.js",
    "acceptance:browser-cdp-dom": "pnpm build && node dist/acceptance-browser-cdp-dom-diagnostic.js",
    "acceptance:save-m1": "tsx scripts/acceptance-save-m1.ts",
    "acceptance:save-m2": "tsx scripts/acceptance-save-m2.ts",
    "acceptance:save-m3-plan": "tsx scripts/acceptance-save-m3-plan.ts",
    "acceptance:save-m3-apply": "tsx scripts/acceptance-save-m3-apply.ts",
    "acceptance:save-m3-rollback-plan": "tsx scripts/acceptance-save-m3-rollback-plan.ts",
    "acceptance:save-m3-rollback-apply": "tsx scripts/acceptance-save-m3-rollback-apply.ts",
    "acceptance:save-m3-rollback-verify": "tsx scripts/acceptance-save-m3-rollback-verify.ts",
    "acceptance:save-m4-research": "tsx scripts/acceptance-save-m4-research.ts",
    "acceptance:save-m4-download-plan": "tsx scripts/acceptance-save-m4-download-plan.ts",
    "acceptance:save-m5": "tsx scripts/acceptance-save-m5.ts",
    "acceptance:save-m6-plan": "tsx scripts/acceptance-save-m6-plan.ts",
    "acceptance:save-m6-apply": "tsx scripts/acceptance-save-m6-apply.ts",
    "acceptance:save-m6-restore-plan": "tsx scripts/acceptance-save-m6-restore-plan.ts",
    "acceptance:save-m6-restore-verify": "tsx scripts/acceptance-save-m6-restore-verify.ts",
    "acceptance:save-g3-g5": "tsx scripts/acceptance-save-g3-g5.ts",
    "acceptance:save-g5-download": "tsx scripts/acceptance-save-g5-download.ts",
    "acceptance:save-g6": "tsx scripts/acceptance-save-g6.ts",
    "acceptance:save-g7-plan": "tsx scripts/acceptance-save-g7-plan.ts",
    "acceptance:save-g7-apply": "tsx scripts/acceptance-save-g7-apply.ts",
    "acceptance:save-g7-restore-plan": "tsx scripts/acceptance-save-g7-restore-plan.ts",
    "acceptance:save-g7-restore-apply": "tsx scripts/acceptance-save-g7-restore-apply.ts",
    "acceptance:save-g7-restore-verify": "tsx scripts/acceptance-save-g7-restore-verify.ts",
    "setup:browser": "playwright install --no-shell chromium",
    "browser:list": "playwright install --list"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright": "1.61.1",
    "yauzl": "^3.4.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "yazl": "^3.3.1"
  },
  "packageManager": "pnpm@11.9.0"
}
